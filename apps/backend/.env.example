DATABASE_URL=postgresql+psycopg2://acoustom:acoustom@localhost:5432/acoustom
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=/tmp/acoustom-uploads
SIMULATION_TIMEOUT=300
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=2592000
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
SIMULATION_AUDIO_TTL_SECONDS=3600
SIMULATION_AUDIO_MAX_BYTES=52428800
# Neon Object Storage (S3-compatible). Leave empty to use local /static storage in development.
NEON_OBJECT_STORAGE_ENDPOINT=
NEON_OBJECT_STORAGE_BUCKET=
NEON_OBJECT_STORAGE_ACCESS_KEY_ID=
NEON_OBJECT_STORAGE_SECRET_ACCESS_KEY=
