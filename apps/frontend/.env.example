# Local development uses Vite's /api proxy. On Vercel set this to the HTTPS
# Cloud Run service URL, for example https://acoustom-api-abc-uc.a.run.app
VITE_API_BASE_URL=
VITE_NEON_AUTH_URL=
# Obtain a token for the deployed HTTPS origin from Chrome's WebMCP origin trial.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=
